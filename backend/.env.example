# RootU Backend Configuration Template
# Duplicate this file to .env and populate credentials

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/rootu_dev"

# Redis Cache & Pub/Sub
REDIS_URL="redis://127.0.0.1:6379"

# JWT Secrets (Minimum 32 characters each)
JWT_ACCESS_SECRET="rootu-production-access-secret-minimum-32-chars-long!"
JWT_REFRESH_SECRET="rootu-production-refresh-secret-minimum-32-chars-long!"
JWT_VERIFICATION_SECRET="rootu-verification-step-bypass-secret-32-chars!"

# Security Configuration
BCRYPT_ROUNDS=12

# Production Twilio SMS Gateway Configuration
# Obtain credentials from Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# Set either TWILIO_FROM_NUMBER (E.164, e.g. +14155552671) or TWILIO_MESSAGING_SERVICE_SID (MG...)
TWILIO_FROM_NUMBER=+14155552671
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
